# Remote MongoDB bridge configuration.
# Copy to .env next to server.js; start-mongo-bridge.bat loads it automatically.
# Every value is OPTIONAL — the defaults below are already baked into server.js.

# Local listener. Keep 127.0.0.1 and publish it ONLY via `ngrok tcp 27018`.
MONGO_BRIDGE_HOST=127.0.0.1
MONGO_BRIDGE_PORT=27018

# Production MongoDB this Windows server forwards to (must be reachable from here).
MONGO_TARGET_HOST=108.181.152.168
MONGO_TARGET_PORT=27017

# Upstream connect retry (auto-reconnect on transient MongoDB blips). Keep
# RETRIES * DELAY well under the driver's connect timeout (~10s).
MONGO_BRIDGE_UPSTREAM_RETRIES=3
MONGO_BRIDGE_RETRY_DELAY_MS=500
