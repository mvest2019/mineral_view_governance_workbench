# Remote MongoDB bridge (TCP/TLS proxy) configuration.
# Copy to .env next to mongo-tcp-proxy.mjs and load it with your process manager.

# Local listener. Keep HOST=127.0.0.1 and publish it ONLY through a tunnel
# (ngrok / Cloudflare) or a reverse proxy — never bind 0.0.0.0 on a public NIC
# without TLS + a firewall.
MONGO_BRIDGE_HOST=127.0.0.1
MONGO_BRIDGE_PORT=27018

# The MongoDB this proxy forwards to. Typically the SAME machine (localhost) or a
# private-network address the proxy host can reach. Production MongoDB is not
# changed and stays private.
MONGO_TARGET_HOST=127.0.0.1
MONGO_TARGET_PORT=27017

# Optional: terminate TLS here so the public hop is encrypted. Provide a
# publicly-trusted certificate for the tunnel hostname (or let the tunnel
# provider terminate TLS instead — then leave these blank). When set, Vercel
# connects with ?tls=true.
MONGO_BRIDGE_TLS_CERT_FILE=
MONGO_BRIDGE_TLS_KEY_FILE=

# Optional idle timeout in ms (0 = disabled). MongoDB pools are long-lived; leave
# 0 unless you want to reap abandoned sockets.
MONGO_BRIDGE_IDLE_MS=0
